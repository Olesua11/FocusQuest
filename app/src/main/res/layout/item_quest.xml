<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/questIcon" android:layout_width="46dp" android:layout_height="46dp" android:gravity="center"
            android:background="@drawable/bg_circle" android:text="⚔" android:textSize="20sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/questTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/questSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" />
        </LinearLayout>
        <TextView android:id="@+id/questReward" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/questProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
        android:layout_height="6dp" android:layout_marginTop="14dp" android:max="100" android:progressTint="@color/accent" />
</LinearLayout>
